generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../../packages/agent-storage/agent.db"
}

model ModelProfile {
  id        String  @id
  name      String
  provider  String
  model     String
  baseUrl   String  @map("base_url")
  apiKey    String  @map("api_key")
  isDefault Boolean @default(false) @map("is_default")
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")

  @@map("model_profiles")
}

model Workspace {
  id           String @id
  path         String @unique
  name         String
  createdAt    BigInt @map("created_at")
  lastOpenedAt BigInt @map("last_opened_at")

  sessions Session[]

  @@map("workspaces")
}

model Session {
  id          String    @id
  workspaceId String    @map("workspace_id")
  title       String
  status      String    @default("active")
  createdAt   BigInt    @map("created_at")
  updatedAt   BigInt    @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([workspaceId, updatedAt])
  @@map("sessions")
}

model Message {
  id           String   @id
  sessionId    String   @map("session_id")
  turnId       String?  @map("turn_id")
  role         String
  content      String
  reasoning    String?
  toolCalls    String?  @map("tool_calls")
  streamStatus String?  @map("stream_status")
  startedAt    BigInt?  @map("started_at")
  completedAt  BigInt?  @map("completed_at")
  sequence     Int
  createdAt    BigInt   @map("created_at")
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequence])
  @@index([sessionId, sequence])
  @@map("messages")
}
