{
  "name": "@hcode/file-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/file-manager.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "node node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.json --noEmit && node node_modules/vite/bin/vite.js build && node node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.build.json",
    "typecheck": "node node_modules/vue-tsc/bin/vue-tsc.js -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "codemirror": "^6.0.0",
    "pinia": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-sql": "^6.8.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "lucide-vue-next": "^1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
