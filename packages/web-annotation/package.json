{
  "name": "@hcode/web-annotation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "default": "./dist/iife/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && pnpm run build:inspect",
    "build:inspect": "vite build --config vite.inspect.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
